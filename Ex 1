<!DOCTYPE html>
<html lang="pt-br">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>avaliaMais - Avaliação por QR Code</title>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;800&display=swap" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/qrcodejs@1.0.0/qrcode.min.js"></script>
<style>
*{margin:0;padding:0;box-sizing:border-box;font-family:'Inter',sans-serif}
body{background:#f8fafc;color:#0f172a}
header{display:flex;justify-content:space-between;align-items:center;padding:18px 5%;background:#0f172a;color:#fff}
.logo{font-weight:800;font-size:26px}.logo span{color:#3b82f6}
.hero{text-align:center;padding:80px 8%;background:linear-gradient(180deg,#0f172a,#1e3a8a);color:#fff}
.hero h1{font-size:38px;max-width:750px;margin:0 auto 12px;line-height:1.1}
.btn{background:#3b82f6;color:#fff;padding:14px 28px;border-radius:12px;font-weight:700;border:none;cursor:pointer;text-decoration:none;display:inline-block;margin:8px}
.btn-dark{background:#0f172a}
.container{max-width:600px;margin:30px auto;background:#fff;padding:28px;border-radius:16px;box-shadow:0 10px 30px rgba(0,0,0,.08)}
input,select,textarea{width:100%;padding:14px;margin:8px 0;border:1px solid #e2e8f0;border-radius:10px;outline:none}
textarea{height:100px}
.ranking{max-width:900px;margin:20px auto;display:grid;gap:12px;padding:0 5%}
.card{background:#fff;padding:18px;border-radius:12px;display:flex;justify-content:space-between;align-items:center;box-shadow:0 2px 10px rgba(0,0,0,.06)}
.stars{font-size:44px;cursor:pointer;color:#e2e8f0;text-align:center}
.stars span.active{color:#f59e0b}
.hidden{display:none}
table{width:100%;border-collapse:collapse}th,td{padding:10px;border:1px solid #e2e8f0;font-size:13px;text-align:left}
.search{max-width:500px;margin:-30px auto 30px;padding:0 5%}
#busca{box-shadow:0 8px 20px rgba(0,0,0,.1)}
</style>
</head>
